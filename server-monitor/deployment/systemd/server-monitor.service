[Unit]
Description=Server Monitor Platform Master Service (Docker + Collector)
After=network.target network-online.target docker.service
Requires=docker.service
Wants=server-monitor-collector.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/server-monitor/server-monitor

# 1. Start Docker containers (Backend + Frontend)
ExecStartPre=/usr/bin/docker compose up -d --remove-orphans

# 2. Start host monitoring collector service
ExecStart=/usr/bin/systemctl start server-monitor-collector.service

# 3. Clean Shutdown: stop collector and bring down docker containers
ExecStop=/usr/bin/systemctl stop server-monitor-collector.service
ExecStopPost=/usr/bin/docker compose down

# Reload action
ExecReload=/usr/bin/docker compose restart

[Install]
WantedBy=multi-user.target
