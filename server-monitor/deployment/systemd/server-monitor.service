[Unit]
Description=Server Monitor FastAPI Backend Service
After=network.target network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/server-monitor/backend
ExecStart=/usr/bin/python3 -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
