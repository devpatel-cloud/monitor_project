[Unit]
Description=Server Monitor Platform Master Service (Native Backend + Host Agent)
After=network.target network-online.target
Wants=server-monitor-backend.service server-monitor-collector.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/server-monitor/server-monitor

# 1. Start Native FastAPI Backend and Host Collector
ExecStart=/usr/bin/systemctl start server-monitor-backend.service server-monitor-collector.service

# 2. Stop both services cleanly
ExecStop=/usr/bin/systemctl stop server-monitor-backend.service server-monitor-collector.service

# 3. Reload/Restart action
ExecReload=/usr/bin/systemctl restart server-monitor-backend.service server-monitor-collector.service

[Install]
WantedBy=multi-user.target
